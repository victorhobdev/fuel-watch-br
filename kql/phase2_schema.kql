// Laboratório histórico sintético; nenhum dado oficial é escrito nesta tabela.
.create-merge table lab_historical_events (event_id:string,lab_run_id:string,posto_id:string,uf:string,produto:string,unidade:string,moeda:string,event_time:datetime,sequence:long,preco:real,is_synthetic:bool,is_late_fixture:bool,benchmark_version:string,benchmark_status:string,alert_score:real)
.alter table lab_historical_events policy ingestiontime true
